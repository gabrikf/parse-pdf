# Copy to .env, then set SESSION_SECRET (32+ bytes): python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Every value left empty falls back to the default written next to it in compose.yaml.

# Required: signs the anonymous session cookie (HS256). The API refuses to start without it.
SESSION_SECRET=
# OpenRouter key for gemini-3.1-flash-lite, gpt-5-mini and Llama Guard. Empty: pypdf still parses,
# summaries end with provider_not_configured.
OPENROUTER_API_KEY=
# Default https://openrouter.ai/api/v1; the e2e stack points it at the local stub.
OPENROUTER_BASE_URL=
# Default google/gemini-3.1-flash-lite (the brief's " gemini-3.1-flash-lite ” is accepted too).
SUMMARY_MODEL_ID=
# Default S6,S7,S8: Llama Guard categories that do not block a document (specialized advice,
# privacy, intellectual property - a lab report, an ID number, a book). `none` blocks every category.
GUARDRAIL_ALLOWED_CATEGORIES=
# Default 120: seconds one model parse call may take (summary and guardrail calls keep 60).
OPENROUTER_PARSE_TIMEOUT_S=
# Default 10 and 3: pages per model parse call; GPT-5 Mini writes slower, so its chunks are smaller.
GEMINI_PARSER_CHUNK_PAGES=
GPT_PARSER_CHUNK_PAGES=
# Default 30 OpenRouter calls per rolling minute, shared by every worker.
OPENROUTER_CALLS_PER_MINUTE=
# Default 3000 model pages per UTC day.
MODEL_PAGE_BUDGET_PER_DAY=
# Default http://localhost:8080 - the only origin CORS allows.
PAGE_ORIGIN=
# Default false; set true behind HTTPS.
COOKIE_SECURE=
# Credentials of the internal S3 store (not published to the host). Defaults are local-only.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Default documents.
S3_BUCKET=
# Default 60000: a crashed job is reclaimed after this idle time.
JOB_CLAIM_IDLE_MS=
# Default INFO.
LOG_LEVEL=
# Host port of the page and API. Default 8080.
WEB_PORT=
